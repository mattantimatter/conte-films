# Resend — required for contact/lead form emails in production
# Create a key at https://resend.com/api-keys
# Verify contefilms.com at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxx

# Destination inbox for every lead submission
CONTACT_TO_EMAIL=hello@contefilms.com

# Must use a verified Resend domain (contefilms.com after DNS setup)
CONTACT_FROM_EMAIL=Conté Films <hello@contefilms.com>
